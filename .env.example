# Copiez ce fichier en .env et remplacez les valeurs.
# L'application refuse de démarrer si les secrets sont absents, trop courts
# ou s'ils contiennent encore « remplacer ».

# Code partagé avec les amis (au moins 8 caractères)
CODE_ACCES=XXX

# Mot de passe de la page /admin (au moins 12 caractères, différent du code)
ADMIN_MOT_DE_PASSE=XXX
# production : cookies Secure obligatoires et en-tête HSTS
# En local sur votre PC (HTTP, sans HTTPS), mettez plutôt :
#   ENVIRONNEMENT=developpement
#   COOKIES_SECURISES=false
ENVIRONNEMENT=developpement

# Taille maximale d'une photo, en Mo
TAILLE_MAX_PHOTO_MO=25

# Durée des sessions
SESSION_AMI_JOURS=30
SESSION_ADMIN_MINUTES=120

# Clé d'authentification Tailscale (utilisée seulement par le conteneur tailscale)
# https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=tskey-auth-a-remplacer
